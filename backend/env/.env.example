# =============================================================================
# Renfit Backend — Environment configuration
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# =============================================================================

# --- Anthropic (AI Coach — claude-haiku) ---
ANTHROPIC_API_KEY=
# Haiku model for fast, cost-effective chat responses
ANTHROPIC_MODEL=claude-3-5-haiku-20241022
ANTHROPIC_MAX_TOKENS=1024

# --- Google Sheets (MVP data store — one spreadsheet file per object) ---
# API key (optional; Sheets read/write uses service account below)
GOOGLE_API_KEY=
# Service account JSON — download from GCP, share both sheets with client_email
GOOGLE_SERVICE_ACCOUNT_FILE=env/service-account.json
# Full URL of the Customers spreadsheet file
GOOGLE_CUSTOMERS_SHEET_URL=
# Full URL of the Bookings spreadsheet file
GOOGLE_BOOKINGS_SHEET_URL=
# Optional: worksheet tab name inside each file (leave empty = first tab)
GOOGLE_CUSTOMERS_SHEET_TAB=
GOOGLE_BOOKINGS_SHEET_TAB=

# --- API server ---
API_HOST=0.0.0.0
API_PORT=8000
API_ENV=development
# Comma-separated origins for CORS (Vite dev server default)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- AI Coach behavior ---
# Max conversation turns kept in context (per session)
AI_MAX_HISTORY_TURNS=20
# Request timeout in seconds when calling Anthropic
AI_REQUEST_TIMEOUT=60

# --- Logging ---
LOG_LEVEL=INFO
