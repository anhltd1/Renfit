# ── Secrets / environment ─────────────────────────────────────────
# Only the example file and README inside env/ are tracked.
# All real .env files are ignored here and at the root.
env/.env
env/.env.local
env/*.local
*.env

# ── Python bytecode ───────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg
*.egg-info/

# ── Virtual environments ──────────────────────────────────────────
.venv/
venv/
.Python

# ── Testing / coverage ───────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/

# ── Logs ──────────────────────────────────────────────────────────
*.log

# ── IDE / OS ─────────────────────────────────────────────────────
.idea/
.vscode/
.DS_Store
Thumbs.db
