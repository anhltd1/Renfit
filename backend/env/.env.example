# =============================================================================
# Renfit Backend — Environment configuration
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# =============================================================================

# --- Anthropic (AI Coach — claude-haiku) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-20241022
ANTHROPIC_MAX_TOKENS=1024

# --- MongoDB ---
MONGODB_URI=
DB_NAME=renfit

# --- API server ---
API_HOST=0.0.0.0
API_PORT=8000
API_ENV=development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- AI Coach behavior ---
AI_MAX_HISTORY_TURNS=20
AI_REQUEST_TIMEOUT=60

# --- Logging ---
LOG_LEVEL=INFO
