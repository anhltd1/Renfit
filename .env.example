# =============================================================================
# Renfit — Deployment-specific configuration (U9 Deployment)
# Non-secret values consumed by docker-compose.yml via variable substitution.
# Copy this file to .env at the repo root and fill in your values:
#   cp .env.example .env
#
# Secrets (API keys, MongoDB URI) live separately in backend/env/.env — see
# backend/env/.env.example. Never put secrets in this file.
# =============================================================================

# Public domain pointing at this VM's IP (required for Caddy's automatic
# Let's Encrypt TLS certificate — see Caddyfile). For local Docker testing
# without a real domain, use ":80" (plain HTTP, no cert management).
# IMPORTANT: do NOT set this to "localhost" — Caddy treats any hostname as
# a real domain needing HTTPS and will fail to start without a working CA
# trust-store setup (the error looks like a missing "certutil" tool).
DOMAIN=:80

# Comma-separated list of origins allowed to call the backend API.
# In production this should be your HTTPS domain, e.g.:
#   CORS_ORIGINS=https://renfit.example.com
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
