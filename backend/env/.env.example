# =============================================================================
# Renfit Backend — Environment configuration
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# =============================================================================

# --- Anthropic (AI Coach — claude-haiku) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-20241022
ANTHROPIC_MAX_TOKENS=1024

# --- MongoDB ---
# When running via docker-compose, this is overridden by the environment
# variable in docker-compose.yml (points to the local mongo container).
# Only set this manually if running the backend outside Docker (e.g. local dev).
MONGODB_URI=mongodb://localhost:27017/renfit
DB_NAME=renfit

# --- API server ---
API_HOST=0.0.0.0
API_PORT=8000
API_ENV=development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- AI Coach behavior ---
AI_MAX_HISTORY_TURNS=20
AI_REQUEST_TIMEOUT=60

# --- Web Push (VAPID) ---
# Generate keys: python -c "from pywebpush import webpush; from py_vapid import Vapid; v=Vapid(); v.generate_keys(); print('Public:', v.public_key); print('Private:', v.private_key)"
# Or use: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CONTACT_EMAIL=mailto:admin@renfit.local

# --- Logging ---
LOG_LEVEL=INFO
