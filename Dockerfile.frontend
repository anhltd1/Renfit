# Frontend image — build from repo root: docker build -f Dockerfile.frontend -t renfit-frontend .
#
# Multi-stage (U9 Deployment): stage 1 builds the production SPA bundle with
# Vite; stage 2 serves it with Caddy, which also reverse-proxies /api and
# /chat to the backend service and automatically provisions/renews a Let's
# Encrypt TLS certificate for DOMAIN (see Caddyfile). Replaces the previous
# single-stage image that ran the Vite *dev server* in production.

# ── Stage 1: build ───────────────────────────────────────────────────────
FROM node:20-alpine AS build

WORKDIR /app

COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci

COPY frontend/ .
RUN npm run build

# ── Stage 2: Caddy with the DuckDNS DNS module ──────────────────────────
# Lets Caddy prove domain ownership via a DNS TXT record (ACME DNS-01)
# instead of Let's Encrypt connecting to this server — needed when the host
# blocks inbound traffic from abroad. Only used if caddy/*.caddy configures
# it (see caddy/README.md); otherwise Caddy behaves exactly as stock.
FROM caddy:2.11.9-builder-alpine AS caddy-build
RUN xcaddy build --with github.com/caddy-dns/duckdns@v0.5.0

# ── Stage 3: serve ───────────────────────────────────────────────────────
FROM caddy:2.11.9-alpine

COPY --from=caddy-build /usr/bin/caddy /usr/bin/caddy
COPY --from=build /app/dist /usr/share/caddy
COPY Caddyfile /etc/caddy/Caddyfile

EXPOSE 80 443
